{
  "name": "qa-context-overlay",
  "version": "0.1.0",
  "private": true,
  "description": "Context and guardrails for AI agents doing QA. Claude drives a real browser through Playwright MCP under a per-environment policy, and a quality gate refuses a test that proves nothing.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:watch": "playwright test --project=unit --ui",
    "test:unit": "playwright test --project=unit",
    "test:failed": "playwright test --last-failed",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "triage": "tsx src/cli/triage.ts",
    "assert-quality": "tsx src/cli/assert-quality.ts apps tests",
    "serve:fixture": "node apps/todo-fixture/app/server.mjs",
    "scan": "tsx src/cli/scan.ts",
    "test:external": "cross-env RUN_EXTERNAL=1 playwright test --project=countdown-timer --project=fakerestapi",
    "gate": "tsx src/cli/gate.ts",
    "check-report": "tsx src/cli/check-report.ts",
    "mutate": "tsx src/cli/mutate.ts",
    "role": "tsx src/cli/role.ts",
    "targets": "tsx src/cli/targets.ts",
    "crawl": "tsx src/cli/crawl.ts",
    "precommit": "tsx src/cli/precommit.ts",
    "plan:facts": "tsx src/cli/plan-facts.ts",
    "ideas": "tsx src/cli/ideas.ts",
    "fault-check": "tsx src/cli/fault-check.ts",
    "archive-results": "tsx src/cli/archive-results.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.266",
    "yaml": "^2.9.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/mcp": "^0.0.80",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.9",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
